{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/@modelcontextprotocol/sdk/types"
    ],
    "outDir": "./dist",
    "rootDir": "./src",
    "noImplicitAny": false
  },
  "include": [
    "src/**/*",
    "proxy.js"
  ],
  "exclude": [
    "node_modules"
  ]
}